# Copy to .env and fill in GITHUB_TOKEN. Never commit .env.

# ---- GitHub --------------------------------------------------------------------------
# Fine-grained or classic PAT with *public repo read* access only (no scopes needed).
GITHUB_TOKEN=
GITHUB_ORG=home-assistant
# Comma-separated repos; empty = every public, non-archived repo of the org.
REPO_ALLOWLIST=
MAX_PRS_PER_REPO=5000
EXTRACT_MAX_WORKERS=8
# Uncomment to widen the merge window (demo/backfill). Unset = the run's data interval.
# LOOKBACK_DAYS=7

# ---- Compliance rules ----------------------------------------------------------------
MIN_APPROVALS=1
NO_CHECKS_PASSES=false
EXCLUDE_BOTS=false

# ---- Data-quality thresholds ---------------------------------------------------------
DQ_FRESHNESS_HOURS=48
DQ_MIN_PRS=1
DQ_VOLUME_DROP_RATIO=0.5
DQ_MAX_QUARANTINE_RATE=0.05
DQ_MAX_COMPLIANCE_DRIFT_PTS=20

# ---- Alerting (Mailpit inbox at http://localhost:8025) -------------------------------
ALERT_EMAIL_TO=data-alerts@example.com

# ---- Airflow -------------------------------------------------------------------------
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__API_AUTH__JWT_SECRET=change-me-local-only-jwt-secret
FERNET_KEY=

# ---- Output database (exposed on localhost:5433) -------------------------------------
COMPLIANCE_DB_USER=compliance
# Avoid passwords that are ordinary words: Airflow masks every occurrence of a
# connection password in logs (a password of "compliance" turns pr_compliance into pr_***).
COMPLIANCE_DB_PASSWORD=change-me-local-pw
COMPLIANCE_DB_NAME=compliance

# ---- Host ports (change if something else already uses them) -------------------------
AIRFLOW_PORT=8080
COMPLIANCE_DB_PORT=5433
MAILPIT_PORT=8025
GRAFANA_PORT=3000

{
  "uid": "pr-compliance",
  "title": "PR Compliance",
  "tags": [
    "compliance",
    "github"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Compliance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Compliance rate (latest run)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT compliance_rate::float AS \"compliance\" FROM compliance_summary WHERE repository='__all__' ORDER BY run_date DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Humans only (latest run)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT human_compliance_rate::float AS \"humans only\" FROM compliance_summary WHERE repository='__all__' ORDER BY run_date DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "Merged PRs (latest run)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT total_prs AS \"PRs\" FROM compliance_summary WHERE repository='__all__' ORDER BY run_date DESC LIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Non-compliant PRs (latest run)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT total_prs - compliant_prs AS \"violations\" FROM compliance_summary WHERE repository='__all__' ORDER BY run_date DESC LIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Compliance rate over time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT run_date::timestamp AS time, compliance_rate::float AS \"all PRs\", human_compliance_rate::float AS \"humans only\"\nFROM compliance_summary WHERE repository='__all__' AND $__timeFilter(run_date::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Violations by reason (last 30 days)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT reason, count(*) AS prs FROM pr_compliance, unnest(violation_reasons) AS reason\nWHERE merged_at >= now() - interval '30 days' GROUP BY reason ORDER BY prs DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      }
    },
    {
      "id": 8,
      "title": "Compliance by repository (last 30 days, repos with >= 3 PRs)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT repository, avg(is_compliant::int)::float AS compliance, count(*) AS prs FROM pr_compliance\nWHERE merged_at >= now() - interval '30 days' GROUP BY repository HAVING count(*) >= 3 ORDER BY compliance"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "prs"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Latest non-compliant PRs",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT merged_at, repository, pr_number, pr_title, author, array_to_string(violation_reasons, ', ') AS reasons, pr_url FROM v_violations LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pr_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open PR",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Pipeline health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Data freshness (hours since newest merge)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(merged_at)) / 3600 AS hours FROM pr_compliance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 12,
      "title": "Last task runs",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 26,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT started_at, run_id, task_id, map_index, status, (metrics->>'duration_s')::float AS duration_s, (metrics->>'api_calls')::int AS api_calls, left(error, 120) AS error\nFROM etl_runs ORDER BY started_at DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green"
                      },
                      "failed": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "title": "GitHub API calls and min rate-limit remaining per run",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', min(started_at)) AS time, sum((metrics->>'api_calls')::int) AS api_calls,\n       min((metrics->>'min_rate_limit_remaining')::int) AS min_rate_limit_remaining\nFROM etl_runs WHERE task_id IN ('extract','list_repos') AND $__timeFilter(started_at) GROUP BY run_id ORDER BY 1"
        }
      ]
    },
    {
      "id": 14,
      "title": "Records quarantined per run",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compliance-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compliance-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT run_date::text AS run, sum((metrics->>'records_quarantined')::int) AS quarantined, sum((metrics->>'records_valid')::int) AS valid\nFROM etl_runs WHERE task_id = 'transform' GROUP BY run_date ORDER BY run_date"
        }
      ],
      "options": {
        "stacking": "normal",
        "showValue": "auto"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}